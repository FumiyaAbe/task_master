<div class="form">
  <h1 class="hero-title">新規登録</h1>
  <p class="hero-sub">必要事項を入力し、アカウントを作成してください。</p>

  <% if resource && resource.errors.any? %>
    <div class="error_notification">
      <strong>入力内容を確認してください</strong>
      <ul>
        <% resource.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <div class="form-row">
      <%= f.label :email, "メールアドレス", class: "form-label" %>
      <%= f.input_field :email,
            required: true,
            autofocus: true,
            autocomplete: "email",
            class: "input" %>
      <p class="form-hint">例: you@example.com</p>
    </div>

    <div class="form-row">
      <%= f.label :password, "パスワード（6文字以上）", class: "form-label" %>
      <%= f.input_field :password,
            required: true,
            autocomplete: "new-password",
            class: "input" %>
      <% if @minimum_password_length.present? %>
        <p class="form-hint"><%= @minimum_password_length %> 文字以上で入力してください。</p>
      <% end %>
    </div>

    <div class="form-row">
      <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
      <%= f.input_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            class: "input" %>
    </div>

    <div class="form-actions">
      <%= link_to "キャンセル", root_path, class: "btn btn-ghost-dark" %>
      <%= f.button :submit, "登録する", class: "btn btn-accent btn-lg" %>
    </div>
  <% end %>
</div>
