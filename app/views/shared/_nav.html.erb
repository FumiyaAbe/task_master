<nav class="site-header sticky top-0 z-40 w-full border-b backdrop-blur bg-main text-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between p-3">
    <!-- Brand -->
    <%= link_to "Task Master", root_path, class: "text-lg font-bold text-white" %>

    <!-- Desktop menu -->
    <div class="hidden gap-3 md:flex">
      <% if user_signed_in? %>
        <%# ナビは現状のアクティブ判定(nav_link_to)を維持 %>
        <%= nav_link_to "Tasks",  tasks_path,  variant: :dark, match: :prefix %>
        <%= nav_link_to "Events", events_path, variant: :dark, match: :prefix %>

        <%# ログアウトはヘッダー用のゴーストボタン %>
        <%= button_to "ログアウト",
              destroy_user_session_path,
              method: :delete,
              data: { turbo: false },
              class: "btn btn-ghost-dark" %>
      <% else %>
        <%# 未ログイン時はヘッダー用のボタンに統一 %>
        <%= link_to "ログイン",   new_user_session_path,      class: "btn btn-ghost-dark" %>
        <%= link_to "新規登録",   new_user_registration_path, class: "btn btn-accent-dark" %>
      <% end %>
    </div>

    <!-- Mobile menu -->
    <details class="md:hidden">
      <summary class="cursor-pointer rounded-lg px-3 py-2 text-sm text-white hover:bg-white/10">メニュー</summary>
      <div class="mt-2 flex flex-col gap-2 rounded-lg border border-white/20 bg-main/95 p-2">
        <% if user_signed_in? %>
          <%= nav_link_to "Tasks",  tasks_path,  variant: :dark, match: :prefix, class: "w-full" %>
          <%= nav_link_to "Events", events_path, variant: :dark, match: :prefix, class: "w-full" %>
          <%= button_to "ログアウト",
                destroy_user_session_path,
                method: :delete,
                data: { turbo: false },
                class: "btn btn-ghost-dark w-full" %>
        <% else %>
          <%= link_to "ログイン",   new_user_session_path,      class: "btn btn-ghost-dark w-full" %>
          <%= link_to "新規登録",   new_user_registration_path, class: "btn btn-accent-dark w-full" %>
        <% end %>
      </div>
    </details>
  </div>
</nav>
